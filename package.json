{
  "name": "allies-interface",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --filter web dev",
    "dev:mobile": "bun --filter mobile start",
    "build:web": "bun --filter web build",
    "lint:web": "bun --filter web lint",
    "lint:mobile": "bun --filter mobile lint",
    "lint": "bun run lint:web && bun run lint:mobile",
    "remotion": "remotion studio remotion/index.ts",
    "remotion:waitlist": "remotion studio remotion/videos/waitlist/entrypoint.ts",
    "remotion:render": "bun run remotion:render:waitlist",
    "remotion:render:waitlist": "remotion render remotion/videos/waitlist/entrypoint.ts Waitlist-AlliesIntro out/waitlist/allies-intro.mp4 --gl=angle --chrome-mode=chrome-for-testing --hardware-acceleration=required"
  },
  "packageManager": "bun@1.2.20",
  "dependencies": {
    "@remotion/cli": "4.0.512",
    "@remotion/gif": "4.0.512",
    "@remotion/media": "4.0.512",
    "@remotion/paths": "4.0.512",
    "gifenc": "^1.0.3",
    "remotion": "4.0.512"
  },
  "devDependencies": {
    "prettier": "3.8.1"
  }
}
